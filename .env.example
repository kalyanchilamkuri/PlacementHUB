# Copy to .env.local and fill in. Never commit .env.local.

# SQLite file, relative to prisma/
DATABASE_URL="file:./dev.db"

# Signs the session cookie. Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Only addresses on this domain can register or sign in.
ALLOWED_EMAIL_DOMAIN="iiitl.ac.in"

# Optional. Shown as the contact address on the privacy and terms pages.
# Left unset, those pages simply omit it rather than inventing one.
SUPPORT_EMAIL=""

# Optional. Used for absolute URLs in metadata.
SITE_URL="http://localhost:3000"

# There is no admin list here on purpose: the first account created on an empty
# portal becomes the placement cell, and it promotes colleagues from Settings.

# Optional. Powers the AI assistant (free key from Google AI Studio).
# Left unset, the chat panel says AI is not configured instead of breaking.
GEMINI_API_KEY=""
# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=""
